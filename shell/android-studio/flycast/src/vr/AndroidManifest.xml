<?xml version="1.0" encoding="utf-8"?>
<!--
    hotd2-vr: merged on top of the main manifest for the "vr" build type. Makes the app an
    immersive OpenXR app on Meta Quest instead of a 2D window.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:horizonos="http://schemas.horizonos/sdk">

    <!-- an immersive app with a 2D setup panel (a "hybrid" app) -->
    <horizonos:uses-horizonos-sdk horizonos:minSdkVersion="69" horizonos:targetSdkVersion="69" />

    <uses-feature android:name="android.hardware.vr.headtracking" android:version="1" android:required="true" />

    <uses-permission android:name="org.khronos.openxr.permission.OPENXR" />
    <uses-permission android:name="org.khronos.openxr.permission.OPENXR_SYSTEM" />
    <!-- the player's game in the Download folder (or anywhere on the shared storage) -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <queries>
        <provider android:authorities="org.khronos.openxr.runtime_broker;org.khronos.openxr.system_runtime_broker" />
        <intent>
            <action android:name="org.khronos.openxr.OpenXRRuntimeService" />
        </intent>
        <intent>
            <action android:name="org.khronos.openxr.OpenXRApiLayerService" />
        </intent>
    </queries>

    <application
        android:label="HOTD2 VR"
        tools:replace="android:label">
        <meta-data android:name="com.oculus.supportedDevices" android:value="quest2|questpro|quest3|quest3s" />
        <meta-data android:name="com.oculus.vr.focusaware" android:value="true" />

        <!-- launch in VR; also openable with a game file, as the regular app -->
        <activity-alias
            android:name="com.flycast.emulator.MainActivity"
            android:targetActivity="com.flycast.emulator.NativeGLActivity"
            android:exported="true"
            tools:node="replace">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="com.oculus.intent.category.VR" />
                <category android:name="org.khronos.openxr.intent.category.IMMERSIVE_HMD" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" android:mimeType="*/*" />
            </intent-filter>
        </activity-alias>

        <!-- the setup panel: what's missing before the first game (VrSetupActivity). In a
             process of its own, so it can end a game still running in the app's own process
             and start the one picked afresh. -->
        <activity
            android:name="com.flycast.emulator.VrSetupActivity"
            android:process=":setup"
            android:exported="true"
            android:resizeableActivity="true"
            android:theme="@android:style/Theme.Material.NoActionBar">
            <layout android:defaultHeight="600dp" android:defaultWidth="860dp" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="com.oculus.intent.category.2D" />
            </intent-filter>
        </activity>
    </application>
</manifest>
